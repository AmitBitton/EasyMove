<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <TextView
        android:text="מצא מוביל"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFillFromProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" מלא כתובות מהאזור האישי"
                android:backgroundTint="#1F4B99"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

            <TextView
                android:text="מאיפה?"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#374151"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSourceAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

            <TextView
                android:id="@+id/tvSourceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="לחץ לבחירת כתובת מוצא"
                android:padding="12dp"
                android:background="#EEF1F4"
                android:textSize="14sp"
                android:textColor="#111827"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:text="לאן?"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#374151"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDestAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

            <TextView
                android:id="@+id/tvDestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="לחץ לבחירת כתובת יעד"
                android:padding="12dp"
                android:background="#EEF1F4"
                android:textSize="14sp"
                android:textColor="#111827"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:text="מתי?"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#374151"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="בחר תאריך הובלה 📅"
                android:backgroundTint="#2F6F6A"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="חפש מובילים מתאימים 🔍"
                android:backgroundTint="#60A5FA"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:textSize="16sp"
                android:enabled="false"
                android:textAllCaps="false"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMovers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>